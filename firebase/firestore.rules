rules_version = '2';

// ═══════════════════════════════════════════════════
// AURA Social – Firestore Security Rules
// ═══════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──
    
    // Kiểm tra user đã đăng nhập
    function isAuthenticated() {
      return request.auth != null;
    }

    // Kiểm tra user là chính chủ
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Kiểm tra field không bị thay đổi
    function isUnchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    // ════════════════════════════════════════════
    // USERS
    // ════════════════════════════════════════════
    match /users/{userId} {
      // Ai cũng đọc được profile public
      allow read: if isAuthenticated();

      // Chỉ chính chủ mới tạo profile của mình
      allow create: if isOwner(userId);

      // Chính chủ sửa profile, hoặc user khác cập nhật followers_count/following_count khi follow
      allow update: if isOwner(userId)
                    || (isAuthenticated()
                        && request.resource.data.diff(resource.data)
                            .changedKeys()
                            .hasOnly(['followers_count', 'following_count']));

      // Cho phép chính chủ tự xóa tài khoản của mình
      allow delete: if isOwner(userId);

      // ── Subcollection: Emotion Profile ──
      match /emotion_profile/{docId} {
        // Chỉ chính chủ đọc emotion profile của mình
        allow read: if isOwner(userId);
        // Chỉ chính chủ hoặc Cloud Functions ghi
        allow write: if isOwner(userId);
      }

      // ── Subcollection: Behavioral Events ──
      match /behavioral_events/{eventId} {
        // Chỉ chính chủ đọc/ghi events của mình
        allow read, write: if isOwner(userId);
      }

      // ── Subcollection: Followers ──
      match /followers/{followerId} {
        // Ai đăng nhập cũng đọc được danh sách followers (public)
        allow read: if isAuthenticated();
        // Chỉ người follow (followerId) mới được tạo/sửa
        allow create, update: if isOwner(followerId);
        // Người follow (followerId) hoặc chủ profile (userId) được phép xóa (khi kick follower hoặc xóa tài khoản)
        allow delete: if isOwner(followerId) || isOwner(userId);
      }

      // ── Subcollection: Following ──
      match /following/{targetUserId} {
        // Ai đăng nhập cũng đọc được danh sách following (public)
        allow read: if isAuthenticated();
        // Chỉ chính chủ (userId) mới được tạo/sửa
        allow create, update: if isOwner(userId);
        // Chính chủ (userId) hoặc người được follow (targetUserId) được phép xóa (khi targetUserId xóa tài khoản)
        allow delete: if isOwner(userId) || isOwner(targetUserId);
      }

      // ── Subcollection: Feed Cache ──
      match /feed_cache/{cacheId} {
        allow read: if isOwner(userId);
        allow write: if false; // Chỉ server ghi
      }
    }

    // ════════════════════════════════════════════
    // POSTS
    // ════════════════════════════════════════════
    match /posts/{postId} {
      // Ai đăng nhập cũng đọc được
      allow read: if isAuthenticated();

      // Tạo post: phải login, user_id phải là mình
      allow create: if isAuthenticated()
                    && request.resource.data.user_id == request.auth.uid;

      // Client có thể cập nhật reaction/comment counters
      allow update: if isAuthenticated();

      // Xóa post: chỉ tác giả
      allow delete: if isAuthenticated()
                    && resource.data.user_id == request.auth.uid;

      match /comments/{commentId} {
        allow read: if isAuthenticated();

        allow create: if isAuthenticated()
                      && request.resource.data.user_id == request.auth.uid;

        allow update: if isAuthenticated()
                      && resource.data.user_id == request.auth.uid;

        allow delete: if isAuthenticated()
                      && resource.data.user_id == request.auth.uid;
      }

      match /reactions/{userId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isOwner(userId);
      }
    }

    // 使用 {path=**} để cho phép Collection Group Query tìm và xóa các comments của user
    match /{path=**}/comments/{commentId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
                    && request.resource.data.user_id == request.auth.uid;

      allow update: if isAuthenticated()
                    && resource.data.user_id == request.auth.uid;

      allow delete: if isAuthenticated()
                    && resource.data.user_id == request.auth.uid;
    }

    // ════════════════════════════════════════════
    // CONVERSATIONS (Chat metadata)
    // ════════════════════════════════════════════
    match /conversations/{conversationId} {
      // Chỉ thành viên cuộc trò chuyện mới đọc được
      allow read: if isAuthenticated()
                  && request.auth.uid in resource.data.participants;

      // Tạo conversation: phải là thành viên
      allow create: if isAuthenticated()
                    && request.auth.uid in request.resource.data.participants;

      // Cập nhật: chỉ thành viên (lastMessage, updatedAt)
      allow update: if isAuthenticated()
                    && request.auth.uid in resource.data.participants;

      allow delete: if isAuthenticated()
                    && request.auth.uid in resource.data.participants;
    }

    // ════════════════════════════════════════════
    // SOUL CONNECTIONS
    // ════════════════════════════════════════════
    match /soul_connections/{connectionId} {
      // Chỉ 2 người trong connection mới đọc được
      allow read: if isAuthenticated()
                  && request.auth.uid in resource.data.participants;

      // Tạo: phải là 1 trong các participants
      allow create: if isAuthenticated()
                    && request.auth.uid in request.resource.data.participants;

      // Cập nhật status (accept/reject)
      allow update: if isAuthenticated()
                    && request.auth.uid in resource.data.participants;

      allow delete: if false;
    }

    // ════════════════════════════════════════════
    // WAVES (Emotional Waves / Groups)
    // ════════════════════════════════════════════
    match /waves/{waveId} {
      // Ai cũng đọc được waves public
      allow read: if isAuthenticated();

      // Chỉ server tạo waves (qua Cloud Functions)
      allow create: if false;
      allow update: if isAuthenticated(); // Members join/leave
      allow delete: if false;

      // ── Subcollection: Wave Members ──
      match /members/{memberId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated()
                     && request.auth.uid == memberId;
      }
    }

    // Cấu hình hỗ trợ Collection Group Query cho Wave Members khi xóa tài khoản
    match /{path=**}/members/{memberId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
                   && request.auth.uid == memberId;
    }

    // ════════════════════════════════════════════
    // NOTIFICATIONS
    // ════════════════════════════════════════════
    match /notifications/{notificationId} {
      // Chỉ người nhận đọc được
      allow read: if isAuthenticated()
                  && resource.data.recipientId == request.auth.uid;

      // Chỉ server tạo notifications
      allow create: if false;

      // Đánh dấu đã đọc
      allow update: if isAuthenticated()
                    && resource.data.recipientId == request.auth.uid;

      allow delete: if isAuthenticated()
                    && resource.data.recipientId == request.auth.uid;
    }

    // ════════════════════════════════════════════
    // REPORTS (Báo cáo vi phạm)
    // ════════════════════════════════════════════
    match /reports/{reportId} {
      // Không ai đọc được (chỉ admin)
      allow read: if false;

      // Ai cũng tạo được report
      allow create: if isAuthenticated()
                    && request.resource.data.reporterId == request.auth.uid;
    }

    // ════════════════════════════════════════════
    // CALLS (Audio / Video signaling)
    // ════════════════════════════════════════════
    match /calls/{callId} {
      // Cho phép đọc nếu là caller hoặc receiver
      allow read: if isAuthenticated()
                    && (request.auth.uid == resource.data.caller_id
                        || request.auth.uid == resource.data.receiver_id);
      
      // Cho phép tạo nếu caller_id là chính mình
      allow create: if isAuthenticated()
                    && request.auth.uid == request.resource.data.caller_id;

      // Cho phép cập nhật nếu là caller hoặc receiver
      allow update: if isAuthenticated()
                    && (request.auth.uid == resource.data.caller_id
                        || request.auth.uid == resource.data.receiver_id);
      
      // Không cho phép xóa cuộc gọi
      allow delete: if false;
    }
  }
}
